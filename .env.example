# Names only — real values live in .env.local (dev) and Railway (deploy).

# The O House API. The portal asks it which club a host belongs to, and gets
# signed photo/signature links from it.
OHOUSE_API_URL=https://api.example.app

# Optional. Replaces the request host: localhost in development, or a
# deployment that should always serve one club (e.g. ohouse.example.app).
CLUB_HOST=

# This server's own key: exchanged with the API for the signed-in person's
# database token (GET /auth/db-token; the API's PORTAL_GATEWAY_KEY is the same
# value), and sent to the Data API gate. SECRET.
OHOUSE_GATEWAY_KEY=

# Used only by scripts/ (pnpm verify:live, verify:writes) — not by the app.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
ADMIN_EMAIL=
ADMIN_PASSWORD=
